# Synthetic.new API key for default provider/search (required)
HYDRA_SYNTHETIC_API_KEY=

# Optional: LLM override key (if different from synthetic key)
HYDRA_API_KEY=

# Optional: Exa search API key
HYDRA_EXA_API_KEY=

# Optional: Brave search API key
HYDRA_BRAVE_API_KEY=

# Optional: Hydra model (default for all phases if orchestrator/research unset)
HYDRA_MODEL=

# Optional: Orchestrator model (decompose + synthesize). Defaults to HYDRA_MODEL if unset.
HYDRA_ORCHESTRATOR_MODEL=

# Optional: Research model (research + debate). Defaults to HYDRA_MODEL if unset.
HYDRA_RESEARCH_MODEL=
